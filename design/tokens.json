{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "canvas": { "$value": "#f7f6f3", "$type": "color" },
    "surface": { "$value": "#ffffff", "$type": "color" },
    "surfaceHover": { "$value": "#efedea", "$type": "color" },
    "surfaceActive": { "$value": "#e3e1db", "$type": "color" },
    "text": { "$value": "#37352f", "$type": "color" },
    "textMuted": { "$value": "#6b6a67", "$type": "color" },
    "textFaint": { "$value": "#9b9a97", "$type": "color" },
    "border": { "$value": "#e5e7eb", "$type": "color" },
    "accent": { "$value": "#2eaadc", "$type": "color" },
    "accentDark": { "$value": "#087ea4", "$type": "color" },
    "success": { "$value": "#0f7b6c", "$type": "color" },
    "danger": { "$value": "#eb5757", "$type": "color" },
    "warning": { "$value": "#dfab01", "$type": "color" }
  },
  "font": {
    "family": { "$value": "-apple-system, BlinkMacSystemFont, Segoe UI, Helvetica Neue, Arial, PingFang SC, Hiragino Sans GB, Microsoft YaHei, sans-serif", "$type": "fontFamily" },
    "mono": { "$value": "ui-monospace, SFMono-Regular, Menlo, monospace", "$type": "fontFamily" }
  },
  "radius": {
    "small": { "$value": "4px", "$type": "dimension" },
    "medium": { "$value": "6px", "$type": "dimension" },
    "large": { "$value": "8px", "$type": "dimension" }
  },
  "space": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" }
  },
  "motion": {
    "fast": { "$value": "150ms", "$type": "duration" }
  },
  "shadow": {
    "small": { "$value": "0 1px 2px rgba(15, 15, 15, 0.06)", "$type": "shadow" },
    "overlay": { "$value": "0 3px 12px #37352f14", "$type": "shadow" }
  }
}
