APP_NAME=飞序 Flowing
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
# 前后端同源留空；分域部署填写明确 origin，逗号分隔，禁止 *。
CORS_ALLOWED_ORIGINS=
# 新空库可选初始化管理员；必须自行设置至少 12 位密码，不再自动创建默认口令账号。
AUTH_BOOTSTRAP_ACCOUNT=admin
AUTH_BOOTSTRAP_PASSWORD=

# Optional. Without a model key, direct lark-cli commands and many heuristic flows still work.
# Click "一键配置 Qwen" in the web UI to write the Bailian-compatible config below.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
ANTHROPIC_API_KEY=

LARK_CLI_LLM_TIMEOUT=25
LARK_AGENT_ENGINE=langgraph
# Per ASGI worker: excess requests are rejected before execution, not queued.
CHAT_MAX_ACTIVE_PER_PROCESS=16
CHAT_MAX_ACTIVE_PER_ACCOUNT=2
# 网站管理员可管理的团队任务清单 GUID，逗号分隔；留空不授予跨创建者管理权。
FEISHU_MANAGED_TASKLIST_IDS=
LARK_CLI_PLAN_LLM_TIMEOUT=8
LARK_CLI_PLAN_TIMEOUT=12
LARK_CLI_COMMAND_TIMEOUT=30
# Private Weixin ClawBot + Telegram channels. Empty Telegram token leaves that channel unavailable.
# Use a dedicated BotFather bot with no webhook: this app uses durable long polling.
BOT_CHANNELS_ENABLED=true
TELEGRAM_BOT_TOKEN=
